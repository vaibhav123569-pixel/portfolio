# Copy to .env and fill privately. Never put credentials inside dist/.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender from your own Twilio console, e.g. whatsapp:+countrycodeNumber
TWILIO_WHATSAPP_FROM=
WHATSAPP_RECIPIENT=whatsapp:+919451876563
# Production: approved template with 1=name, 2=email, 3=message.
# Sandbox: leave blank, join sandbox and maintain active 24-hour window.
TWILIO_CONTENT_SID=
APP_ORIGIN=http://127.0.0.1:5174
PORT=5174
HOST=127.0.0.1
